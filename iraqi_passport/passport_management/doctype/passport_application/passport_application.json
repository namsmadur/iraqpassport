{
 "doctype": "DocType",
 "name": "Passport Application",
 "module": "Passport Management",
 "autoname": "naming_series:",
 "naming_series": "PA-.YYYY.-.#####",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "naming_series", "workflow_state", "section_personal",
  "full_name_ar", "full_name_en", "date_of_birth", "gender",
  "mother_name_ar", "mother_name_en",
  "father_name_ar", "father_name_en",
  "national_id", "place_of_birth",
  "section_photos", "personal_photo", "section_signature", "applicant_signature",
  "section_verification", "field_remarks",
  "section_result", "generated_passport", "rejection_reason"
 ],
 "fields": [
  {"fieldname": "naming_series", "label": "Series", "fieldtype": "Select",
   "options": "PA-.YYYY.-.#####", "default": "PA-.YYYY.-.#####", "hidden": 1, "reqd": 1},
  {"fieldname": "workflow_state", "label": "Status", "fieldtype": "Link",
   "options": "Workflow State", "read_only": 1, "no_copy": 1,
   "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "section_personal", "fieldtype": "Section Break", "label": "Personal Information"},
  {"fieldname": "full_name_ar", "label": "Full Name (Arabic)", "fieldtype": "Data",
   "reqd": 1, "in_list_view": 1},
  {"fieldname": "full_name_en", "label": "Full Name (English)", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "date_of_birth", "label": "Date of Birth", "fieldtype": "Date", "reqd": 1},
  {"fieldname": "gender", "label": "Gender", "fieldtype": "Select",
   "options": "Male\nFemale", "reqd": 1, "in_list_view": 1},
  {"fieldname": "mother_name_ar", "label": "Mother's Name (Arabic)", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "mother_name_en", "label": "Mother's Name (English)", "fieldtype": "Data", "reqd": 1},
  {"fieldname": "father_name_ar", "label": "Father's Name (Arabic)", "fieldtype": "Data"},
  {"fieldname": "father_name_en", "label": "Father's Name (English)", "fieldtype": "Data"},
  {"fieldname": "national_id", "label": "National ID", "fieldtype": "Data",
    "reqd": 1, "in_list_view": 1},
  {"fieldname": "place_of_birth", "label": "Place of Birth", "fieldtype": "Data"},
  {"fieldname": "section_photos", "fieldtype": "Section Break", "label": "Photos"},
  {"fieldname": "personal_photo", "label": "Personal Photo", "fieldtype": "Attach Image", "reqd": 1},
  {"fieldname": "section_signature", "fieldtype": "Section Break", "label": "Applicant Signature / التوقيع"},
  {"fieldname": "applicant_signature", "label": "Applicant Signature / توقيع مقدم الطلب", "fieldtype": "Signature"},
  {"fieldname": "section_verification", "fieldtype": "Section Break", "label": "Verification"},
  {"fieldname": "field_remarks", "label": "Verification Remarks", "fieldtype": "Table",
   "options": "Field Verification Remark",
   "description": "During Officer Review, verify every populated field and enter a remark for it before sending to the Director General."},
  {"fieldname": "section_result", "fieldtype": "Section Break", "label": "Result"},
  {"fieldname": "generated_passport", "label": "Generated Passport", "fieldtype": "Link",
   "options": "Passport", "read_only": 1, "no_copy": 1},
  {"fieldname": "rejection_reason", "label": "Decision / Return Reason", "fieldtype": "Small Text",
   "no_copy": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Data Entry Clerk", "read": 1, "write": 1, "create": 1},
  {"role": "Verification Officer", "read": 1, "write": 1},
  {"role": "Manager", "read": 1},
  {"role": "Director", "read": 1, "write": 1}
 ]
}
