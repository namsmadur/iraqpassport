{
 "doctype": "DocType",
 "name": "Passport",
 "module": "Passport Management",
 "default_print_format": "Iraqi Passport Format",
 "autoname": "field:passport_number",
 "engine": "InnoDB",
 "field_order": [
  "passport_number",
  "status",
  "issue_date",
  "expiry_date",
  "issuing_authority",
  "source_application",
  "section_personal",
  "full_name_ar",
  "full_name_en",
  "date_of_birth",
  "gender",
  "mother_name_ar",
  "mother_name_en",
  "national_id",
  "place_of_birth",
  "personal_photo",
  "applicant_signature"
 ],
 "fields": [
  {
   "fieldname": "passport_number",
   "label": "Passport Number",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "read_only_depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "status",
   "label": "Passport Status",
   "fieldtype": "Select",
   "options": "Draft\nApproved",
   "default": "Draft",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "read_only_depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "issue_date",
   "label": "Issue Date",
   "fieldtype": "Date",
   "read_only_depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "expiry_date",
   "label": "Expiry Date",
   "fieldtype": "Date",
   "read_only_depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "issuing_authority",
   "label": "Issuing Authority",
   "fieldtype": "Data",
   "default": "Republic of Iraq - Ministry of Interior",
   "read_only_depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "source_application",
   "label": "Source Application",
   "fieldtype": "Link",
   "options": "Passport Application",
   "unique": 1,
   "read_only_depends_on": "eval:!doc.__islocal"
  },
  {
   "fieldname": "section_personal",
   "fieldtype": "Section Break",
   "label": "Holder Information"
  },
  {
   "fieldname": "full_name_ar",
   "label": "Full Name (Arabic)",
   "fieldtype": "Data",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "full_name_en",
   "label": "Full Name (English)",
   "fieldtype": "Data",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "date_of_birth",
   "label": "Date of Birth",
   "fieldtype": "Date",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "gender",
   "label": "Gender",
   "fieldtype": "Data",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "mother_name_ar",
   "label": "Mother's Name (Arabic)",
   "fieldtype": "Data",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "mother_name_en",
   "label": "Mother's Name (English)",
   "fieldtype": "Data",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "national_id",
   "label": "National ID",
   "fieldtype": "Data",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "place_of_birth",
   "label": "Place of Birth",
   "fieldtype": "Data",
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "personal_photo",
   "label": "Personal Photo",
   "fieldtype": "Attach Image",
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  },
  {
   "fieldname": "applicant_signature",
   "label": "Applicant Signature",
   "fieldtype": "Signature",
   "read_only_depends_on": "eval:doc.status == 'Approved'"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "delete": 1
  },
  {
   "role": "Verification Officer",
   "read": 1,
   "write": 1
  },
  {
   "role": "Manager",
   "read": 1,
   "print": 1
  },
  {
   "role": "Director",
   "read": 1,
   "print": 1
  }
 ]
}
